{
  "name": "moonlight-web",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=26.4.0 < 27.0.0",
    "npm": ">=11.17.0 < 12.0.0"
  },
  "watch": {
    "build-light": {
      "patterns": [
        "src",
        "web"
      ],
      "extensions": "ts,html,css,svg,png,rs",
      "ignore": "web/api_bindings.d.ts",
      "runOnChangeOnly": false
    }
  },
  "repository": {
    "url": "This is required for uniffi-bindgen-react-native"
  },
  "scripts": {
    "dev": "npm run prebuild && webpack --watch",
    "build": "npm run prebuild && webpack",
    "prebuild": "npm run generate-bindings && npm run build-moonlight-common",
    "generate-bindings": "cargo test export_bindings",
    "build-moonlight-common": "npm run ubrn:checkout && npm run ubrn:build",
    "ubrn:checkout": "ubrn checkout",
    "ubrn:build": "ubrn build web"
  },
  "license": "GPL-3.0-or-later",
  "private": "true",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@ubjs/core": "0.31.0-3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "html-webpack-plugin": "5.6.7",
    "postcss": "^8.5.25",
    "postcss-loader": "^8.2.1",
    "style-loader": "4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-loader": "9.6.0",
    "typescript": "5.9.3",
    "uniffi-bindgen-react-native": "0.31.0-3",
    "webpack": "5.107.2",
    "webpack-cli": "7.0.3"
  }
}
